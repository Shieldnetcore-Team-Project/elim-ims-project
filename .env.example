# Copy to .env and fill in. .env is gitignored — never commit real values.
# For deployments, set these in your hosting provider's environment panel.

# Supabase project (Project Settings -> General / API)
SUPABASE_PROJECT_ID=""
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""

# Server-only. Required by the admin "Create a user account" panel
# (src/lib/admin-users.ts) to call the Supabase Admin API.
# Project Settings -> API Keys -> secret key (starts with sb_secret_).
# Legacy projects may use SUPABASE_SERVICE_ROLE_KEY instead; either name is read.
#
# This key bypasses row-level security completely. Keep it out of git, and never
# add a VITE_ prefixed copy — that would ship it to every browser.
SUPABASE_SECRET_KEY=""

# Same values, VITE_ prefixed, for the browser bundle. Only ever put
# public/publishable values here.
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
